# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build outputs
/.next/
/out/
/build

# TypeScript auto-generated file
# Next.js manages this automatically; do not commit it to version control
next-env.d.ts
*.tsbuildinfo

# Production / sensitive local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel deployment cache and configurations
.vercel

# Testing coverage reports
/coverage

# Debug and system logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System files (macOS / Windows)
.DS_Store
Thumbs.db
